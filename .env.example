# CƠM PHẦN ÚT TRINH — CẤU HÌNH BIẾN MÔI TRƯỜNG VITE (VERCEL / LOCAL .env)
# -----------------------------------------------------------------------------
# 1. Supabase Project URL (tìm trong Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon/Publishable Key (Public key an toàn cho client, KHÔNG dùng service_role)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# 3. UID Quản trị viên ACP (Bắt buộc để xác thực phiên AdminPanel tại #ACP1122)
VITE_ACP_ADMIN_UID=your_admin_user_uuid

# 4. CLOUDINARY USAGE MONITOR — CẤU HÌNH SERVER-SIDE (VERCEL / SERVER ONLY)
# Tuyệt đối KHÔNG thêm tiền tố VITE_ để bảo vệ API Secret không lọt xuống client.
CLOUDINARY_ACC1_CLOUD_NAME=ti6s6oqc
CLOUDINARY_ACC1_API_KEY=your_acc1_api_key
CLOUDINARY_ACC1_API_SECRET=your_acc1_api_secret

CLOUDINARY_ACC2_CLOUD_NAME=onu6v2bb
CLOUDINARY_ACC2_API_KEY=your_acc2_api_key
CLOUDINARY_ACC2_API_SECRET=your_acc2_api_secret

# 5. CLOUDINARY MONITOR — XÁC THỰC SERVER-SIDE (VERCEL / SERVER ONLY)
CLOUDINARY_MONITOR_PIN=your_custom_admin_pin
SESSION_SECRET=your_optional_random_signing_secret


